# ========== SUPER DROPLET METHOD PARAMETERS ==========
# Core SDM settings
super_droplets_moisture.initial_distribution_type = "uniform"
super_droplets_moisture.diagnostics_interval = 10000
super_droplets_moisture.include_phase_change = true
super_droplets_moisture.include_advection = true
super_droplets_moisture.include_coalescence = false

# Domain-averaged time series output
# Outputs: time, temperature, RH, mean radius, number concentration, LWC
super_droplets_moisture.domain_timeseries_interval = 800  # Output every 10 iterations
super_droplets_moisture.domain_timeseries_radius_cutoff = 1.0e-6  # 1 micron cutoff (default)

# ========== AEROSOL INJECTION (Alternative to Recycling) ==========
# Inject fresh aerosols at a specific location with a controlled rate
# This is more physically realistic than recycling for representing sources

# Choose multiplicity type
# super_droplets_moisture.multiplicity_type = "sampled"  # or "constant"
super_droplets_moisture.multiplicity_type = "constant"

# Number of injection sources (can have multiple)
super_droplets_moisture.num_injections = 1

# Injection source 0 configuration
super_droplets_moisture.injection.0.rate = 3355443200   # Physical particles per m³ per second
super_droplets_moisture.injection.0.particles_per_cell = 128 # Injected particles per cell (computational particles, not physical)
#super_droplets_moisture.injection.0.interval = 160           # Inject every 40 timesteps, with this setting multiplicity should be 7.6
super_droplets_moisture.injection.0.t_start = 3600.0       # Start injection at t=120 seconds
super_droplets_moisture.injection.0.t_stop = 1.0e10        # Continue throughout simulation

# Injection region type: "uniform" (box) or "bubble" (sphere)
super_droplets_moisture.injection.0.distribution_type = "uniform"

# For uniform: cubic injection volume centered at (0, 0, 0.5)
# Box extends from (x-0.005, y-0.005, z-0.495) to (x+0.005, y+0.005, z+0.505)
super_droplets_moisture.injection.0.particle_box_lo = -0.0625  -0.0625  0.46875      # meters
super_droplets_moisture.injection.0.particle_box_hi = 0.0625  0.0625  0.53125  # meters
super_droplets_moisture.place_randomly_in_cells = true

# Alternative: For bubble (spherical) injection, use these instead:
# super_droplets_moisture.injection.distribution_type = "bubble"
# super_droplets_moisture.injection.particle_bubble_center = 0.0 0.0 0.1  # Center (x,y,z) in meters
# super_droplets_moisture.injection.particle_bubble_radius = 0.1 0.1 0.05  # Radii (rx,ry,rz) in meters

# Aerosol properties for injected particles
# Note: aerosols defined at main level (line 253), not here

# Aerosol distribution for injected particles
super_droplets_moisture.injection.0.aerosol_distribution_type_NaCl = "mass_constant"
super_droplets_moisture.injection.0.aerosol_mean_mass_NaCl = 2.21e-18

# Initial velocity of injected particles (m/s) - useful for directed sources
# NOTE: domain_velocity moves the INJECTION REGION, not the particle velocities!
# Setting this to non-zero will move the injection box over time.
# For a stationary injection region, use 0 0 0
super_droplets_moisture.injection.0.domain_velocity = 0.0 0.0 0.0  # Stationary injection region

# Coalescence kernel (options: "Halls", "Golovin", "Long", or "None")
super_droplets_moisture.coalescence_kernel = "Halls"

# Advection settings
super_droplets_moisture.prescribed_advection = false
super_droplets_moisture.density_scaling = true
super_droplets_moisture.advect_with_flow = true
super_droplets_moisture.advect_with_gravity = true
super_droplets_moisture.dimensionality = "three_d"  # Full 3D chamber

# ========== PARTICLE MANAGEMENT: Choose INJECTION or RECYCLING ==========
#
# OPTION 1: INJECTION (Recommended - more physically realistic)
#   - Continuously inject fresh aerosols at specific location(s)
#   - Control injection rate, location, and timing
#   - See "AEROSOL INJECTION" section above for configuration
#   - Particles hitting walls are permanently removed
#
# OPTION 2: RECYCLING (Alternative - maintains constant particle count)
#   - Particles hitting walls are reset to dry aerosols and repositioned
#   - Maintains fixed number of computational particles
#   - Less physically realistic but computationally efficient
#
# Enable recycling (set to false if using injection above)
super_droplets_moisture.recycle_particles = false

# Recycling configuration (only used if recycle_particles = true)
super_droplets_moisture.recycle_box_lo = -1.0 -1.0 0.0
super_droplets_moisture.recycle_box_hi =  1.0  1.0 0.1

# Aerosol species and distribution
super_droplets_moisture.species = water
super_droplets_moisture.aerosols = NaCl

# No initial distribution (using injection only)
super_droplets_moisture.num_initializations = 0

# NaCl aerosol distribution FOR INITIALIZATION (not used since num_initializations=0)
# super_droplets_moisture.initial_aerosol_distribution_type_NaCl = "mass_exponential"
# super_droplets_moisture.initial_aerosol_min_mass_NaCl = 1.0e-22   # kg (very small nuclei)
# super_droplets_moisture.initial_aerosol_mean_mass_NaCl = 1.0e-19  # kg (typical CCN)

# Alternative: Use log-normal radius distribution (comment out mass_exponential above and uncomment these)
# super_droplets_moisture.initial_aerosol_distribution_type_NaCl = "radius_log_normal"
# super_droplets_moisture.initial_aerosol_mean_radius_NaCl = 80.0e-9  # m (80 nm)
# super_droplets_moisture.initial_aerosol_min_radius_NaCl = 1e-9      # m (1 nm)
# super_droplets_moisture.initial_aerosol_max_radius_NaCl = 5e-6      # m (5 microns)
# super_droplets_moisture.initial_aerosol_std_radius_NaCl = 0.146     # standard deviation

# Particle density and number
# super_droplets_moisture.initial_number_density = 1.0e7           # m^-3 (10 million droplets/m³)
# super_droplets_moisture.initial_particles_per_cell = 256         # computational particles per cell
super_droplets_moisture.initial_number_density = 0.0           # m^-3 (10 million droplets/m³)

# Phase change solver settings (for condensation/evaporation)
super_droplets_moisture.num_substeps_phase_change = 1
super_droplets_moisture.initial_phase_change_relaxation = false
# super_droplets_moisture.initial_phase_change_relaxation_time = 10.0  # seconds

# Terminal velocity model (options: "RogersYau", "Beard", "KhvorostyanovCurry")
super_droplets_moisture.terminal_velocity_model = "RogersYau"

# Newton solver for implicit integration (if needed)
super_droplets_moisture.newton_solver_tolerance = 1.0e-6
super_droplets_moisture.newton_solver_rtol = 1.0e-6
super_droplets_moisture.newton_solver_max_iterations = 20
super_droplets_moisture.newton_solver_maxits = 20

# Brownian coalescence (typically small effect, can disable for performance)
super_droplets_moisture.include_brownian_coalescence = false


