wallflux.T_wall.xlo = 288.0  # cooler left wall
wallflux.T_wall.xhi = 288.0  # warmer right wall
wallflux.T_wall.ylo = 288.0  # neutral front wall
wallflux.T_wall.yhi = 288.0  # neutral back wall
wallflux.T_wall.zlo = 294.0  # warm bottom wall
