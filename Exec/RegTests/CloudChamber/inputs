wallflux.Cm.yhi = 0.023474
wallflux.Cm.zlo = 0.015511
wallflux.Cm.zhi = 0.015511

# Heat exchange coefficients
wallflux.Ch.xlo = 0.015261
wallflux.Ch.xhi = 0.015261
wallflux.Ch.ylo = 0.015261
wallflux.Ch.yhi = 0.015261
wallflux.Ch.zlo = 0.019916
wallflux.Ch.zhi = 0.019916

