# PROBLEM PARAMETERS (Thermodynamic targets)
prob.rho_0 = 1.20984   # kg/m3 = p_0/(R_d*T_0) = 1e5/(287*288); makes the dry-EOS base-state HSE self-consistent: p_hse=1e5, pi0=1, so T=theta exactly
prob.T_0  = 288.0      # K (used as theta_0 in uniform init)
prob.p_0  = 100000.0   # Pa (for qsat calculation in UserDefined init)
prob.rh_0 = 1.0       # unitless (0–1). Use 1.0 for exactly saturated, qc=0.

# Mean wind and small velocity noise to seed turbulence
prob.U_0 = 0.0
prob.V_0 = 0.0
prob.W_0 = 0.0
prob.U_0_Pert_Mag = 0.1  # m/s
prob.V_0_Pert_Mag = 0.1
prob.W_0_Pert_Mag = 0.00
prob.T_0_Pert_Mag = 0.1

# MOISTURE MODEL - Super Droplet Method
erf.moisture_model  = "SuperDroplets"
erf.buoyancy_type = 1

# WALL FLUX CONFIGURATION
erf.use_wall_fluxes = true

# Wall flux parameters - all faces, momentum drag model
wallflux.enable = true

# Per-face wetness (0.0 = dry, 1.0 = fully saturated)
# Wetness controls moisture flux: q_wall = wetness * q_sat(T_wall, p)
wallflux.wetness.xlo = 1.0  # Fully saturated left wall
wallflux.wetness.xhi = 1.0  # Fully saturated right wall
wallflux.wetness.ylo = 1.0  # Fully saturated front wall
wallflux.wetness.yhi = 1.0  # Fully saturated back wall
wallflux.wetness.zlo = 1.0  # Fully saturated bottom wall
wallflux.wetness.zhi = 1.0  # Partially dry top wall (50% wetness)

# Momentum model for all faces - drag mode
wallflux.momentum_model.xlo = "drag"
wallflux.momentum_model.xhi = "drag"
wallflux.momentum_model.ylo = "drag"
wallflux.momentum_model.yhi = "drag"
wallflux.momentum_model.zlo = "drag"
wallflux.momentum_model.zhi = "drag"

